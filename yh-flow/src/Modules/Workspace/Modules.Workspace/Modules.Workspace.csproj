<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>YH.Modules.Workspace</RootNamespace>
		<AssemblyName>YH.Modules.Workspace</AssemblyName>
		<NoWarn>$(NoWarn);CA1031;CA1056;CA1716;CA1812;S1135;S125;S2094;S3267;S1144</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
